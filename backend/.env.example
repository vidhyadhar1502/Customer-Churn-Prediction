# Backend Environment Configuration
APP_NAME="RetainIQ Customer Churn Prediction API"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DATABASE_URL="sqlite:///./data/churn.db"
MODEL_PATH="./models/churn_model.pkl"
PREPROCESSOR_PATH="./models/preprocessor.pkl"
ARTIFACTS_PATH="./models/model_artifacts.json"
DATASET_PATH="./data/customer_data.csv"
ACTIVE_MODEL="logistic_regression"
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70
MAX_CSV_SIZE_MB=5
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
RANDOM_SEED=42
