# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend API Configuration
VITE_API_BASE_URL="/api"

# Backend & ML Configuration
PORT=3000
FASTAPI_PORT=8000
DATABASE_URL="sqlite:///./backend/data/churn.db"
SQLITE_DB_PATH="./backend/data/churn.db"
MODEL_DIR="./backend/models"
DATASET_PATH="./backend/data/customer_data.csv"
DEFAULT_MODEL_TYPE="logistic_regression"
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70
MAX_CSV_UPLOAD_BYTES=5242880
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
RANDOM_SEED=42

